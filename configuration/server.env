# server.env — LookInside Server, the one Mach-O this package ships that is not
# built here. It is the MIT-licensed LookInside-Server, taken from a published
# LookInside-Release XCFramework and pinned by version and sha256 so every build
# packs the same bytes. scripts/fetch-server.sh downloads and verifies it;
# build-ios.sh stages its iOS device slice and sets the install name per flavor;
# package-deb.sh strips and re-signs it ad hoc like everything else.

# The framework name, installed at <prefix>/Library/Frameworks/<name>.framework.
SERVER_NAME=LookInsideServer

# The pinned release. Bump both together; the digest is the zip's sha256 as
# GitHub reports it for the release asset.
SERVER_VERSION=1.0.1
SERVER_URL=https://github.com/LookInsideApp/LookInside-Release/releases/download/1.0.1/LookInsideServer.xcframework.zip
SERVER_SHA256=ca4f8e15227efb14e967b4475543506379c5fc3b75f7a65ef0861a4c73c9a1df

# Imports the Server keeps despite the injected-code import denylist. The
# Server's whole job is to listen for LookInside on the Mac (loopback TCP that
# usbmuxd forwards over USB), so it creates sockets. Nothing else is excepted,
# and the exception covers only the Server, never the tweak dylib or the prefs
# bundle.
SERVER_IMPORT_EXCEPTIONS="_socket"
